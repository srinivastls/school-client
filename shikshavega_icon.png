<svg width="512" height="512" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">   <defs>     <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">       <stop offset="0%" style="stop-color:#1a1a2e"/>       <stop offset="50%" style="stop-color:#16213e"/>       <stop offset="100%" style="stop-color:#0f3460"/>     </linearGradient>     <linearGradient id="saffron" x1="0%" y1="0%" x2="100%" y2="100%">       <stop offset="0%" style="stop-color:#FF9933"/>       <stop offset="100%" style="stop-color:#FF6B00"/>     </linearGradient>     <linearGradient id="gold" x1="0%" y1="0%" x2="100%" y2="100%">       <stop offset="0%" style="stop-color:#FFD700"/>       <stop offset="100%" style="stop-color:#FFA500"/>     </linearGradient>     <linearGradient id="bookGrad" x1="0%" y1="0%" x2="0%" y2="100%">       <stop offset="0%" style="stop-color:#ffffff"/>       <stop offset="100%" style="stop-color:#e8e8f0"/>     </linearGradient>     <linearGradient id="speedGrad" x1="0%" y1="0%" x2="100%" y2="0%">       <stop offset="0%" style="stop-color:#FF9933;stop-opacity:0"/>       <stop offset="40%" style="stop-color:#FF9933;stop-opacity:0.8"/>       <stop offset="100%" style="stop-color:#FFD700"/>     </linearGradient>     <filter id="glow1">       <feGaussianBlur stdDeviation="6" result="blur"/>       <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>     </filter>     <filter id="glow2">       <feGaussianBlur stdDeviation="12" result="blur"/>       <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>     </filter>     <filter id="shadow">       <feDropShadow dx="0" dy="6" stdDeviation="10" flood-color="#00000060"/>     </filter>     <radialGradient id="centerGlow" cx="50%" cy="55%" r="45%">       <stop offset="0%" style="stop-color:#FF9933;stop-opacity:0.2"/>       <stop offset="100%" style="stop-color:#FF9933;stop-opacity:0"/>     </radialGradient>     <radialGradient id="topGlow" cx="50%" cy="20%" r="40%">       <stop offset="0%" style="stop-color:#4444ff;stop-opacity:0.15"/>       <stop offset="100%" style="stop-color:#4444ff;stop-opacity:0"/>     </radialGradient>   </defs>    <!-- Background -->   <rect width="512" height="512" rx="100" fill="url(#bg)"/>   <rect width="512" height="512" rx="100" fill="url(#centerGlow)"/>   <rect width="512" height="512" rx="100" fill="url(#topGlow)"/>    <!-- Speed lines (vega = velocity) background -->   <g opacity="0.08">     <line x1="0" y1="180" x2="512" y2="180" stroke="#FF9933" stroke-width="1.5"/>     <line x1="0" y1="210" x2="512" y2="210" stroke="#FF9933" stroke-width="1"/>     <line x1="0" y1="235" x2="512" y2="235" stroke="#FF9933" stroke-width="0.8"/>     <line x1="0" y1="255" x2="512" y2="255" stroke="#FF9933" stroke-width="0.6"/>   </g>    <!-- Decorative dots grid top-right -->   <g opacity="0.15" fill="#ffffff">     <circle cx="380" cy="48" r="3"/><circle cx="410" cy="48" r="3"/><circle cx="440" cy="48" r="3"/><circle cx="470" cy="48" r="3"/>     <circle cx="380" cy="78" r="3"/><circle cx="410" cy="78" r="3"/><circle cx="440" cy="78" r="3"/><circle cx="470" cy="78" r="3"/>     <circle cx="380" cy="108" r="3"/><circle cx="410" cy="108" r="3"/><circle cx="440" cy="108" r="3"/>     <circle cx="410" cy="138" r="3"/><circle cx="440" cy="138" r="3"/>   </g>    <!-- Decorative dots bottom-left -->   <g opacity="0.1" fill="#FF9933">     <circle cx="48" cy="370" r="3"/><circle cx="78" cy="370" r="3"/><circle cx="108" cy="370" r="3"/>     <circle cx="48" cy="400" r="3"/><circle cx="78" cy="400" r="3"/>     <circle cx="48" cy="430" r="3"/>   </g>    <!-- ═══ OPEN BOOK ═══ -->   <g filter="url(#shadow)" transform="translate(256,218)">     <!-- Left page -->     <path d="M-140,-85 Q-140,-90 -135,-90 L-8,-90 L-8,85 Q-60,75 -140,80 Z" fill="url(#bookGrad)"/>     <!-- Right page -->     <path d="M8,-90 L135,-90 Q140,-90 140,-85 L140,80 Q60,75 8,85 Z" fill="url(#bookGrad)" opacity="0.9"/>      <!-- Book spine shadow -->     <path d="M-8,-90 L-8,85" stroke="#ccccdd" stroke-width="2"/>     <path d="M8,-90 L8,85" stroke="#ccccdd" stroke-width="2"/>     <rect x="-8" y="-90" width="16" height="175" fill="#e0e0ee"/>      <!-- Lines on left page -->     <line x1="-125" y1="-55" x2="-22" y2="-55" stroke="#c8c8d8" stroke-width="3" stroke-linecap="round"/>     <line x1="-125" y1="-32" x2="-22" y2="-32" stroke="#c8c8d8" stroke-width="3" stroke-linecap="round"/>     <line x1="-125" y1="-9" x2="-22" y2="-9" stroke="#c8c8d8" stroke-width="3" stroke-linecap="round"/>     <line x1="-125" y1="14" x2="-22" y2="14" stroke="#c8c8d8" stroke-width="3" stroke-linecap="round"/>     <line x1="-125" y1="37" x2="-60" y2="37" stroke="#c8c8d8" stroke-width="3" stroke-linecap="round"/>      <!-- Small text-like blocks left -->     <rect x="-125" y="-72" width="50" height="8" rx="4" fill="#FF9933" opacity="0.7"/>     <rect x="-68" y="-72" width="35" height="8" rx="4" fill="#FF9933" opacity="0.4"/>      <!-- Lines on right page -->     <line x1="22" y1="-55" x2="125" y2="-55" stroke="#c8c8d8" stroke-width="3" stroke-linecap="round"/>     <line x1="22" y1="-32" x2="125" y2="-32" stroke="#c8c8d8" stroke-width="3" stroke-linecap="round"/>     <line x1="22" y1="-9" x2="125" y2="-9" stroke="#c8c8d8" stroke-width="3" stroke-linecap="round"/>     <line x1="22" y1="14" x2="125" y2="14" stroke="#c8c8d8" stroke-width="3" stroke-linecap="round"/>     <line x1="22" y1="37" x2="80" y2="37" stroke="#c8c8d8" stroke-width="3" stroke-linecap="round"/>      <!-- Small accent block right -->     <rect x="22" y="-72" width="40" height="8" rx="4" fill="#138808" opacity="0.6"/>     <rect x="70" y="-72" width="45" height="8" rx="4" fill="#138808" opacity="0.3"/>      <!-- Book curve at bottom -->     <path d="M-140,80 Q-70,95 -8,85 L8,85 Q70,95 140,80" fill="none" stroke="#bbbbcc" stroke-width="2"/>   </g>    <!-- ═══ SPEED / VELOCITY SWOOSH (Vega) ═══ -->   <!-- Main speed swoosh going through the book -->   <path d="M30,255 Q120,230 200,248 Q256,260 310,242 Q390,218 480,235"         fill="none" stroke="url(#speedGrad)" stroke-width="5" stroke-linecap="round" opacity="0.9"/>    <!-- Speed lines left (motion blur effect) -->   <g filter="url(#glow1)">     <line x1="32" y1="245" x2="140" y2="240" stroke="#FF9933" stroke-width="4" stroke-linecap="round" opacity="0.8"/>     <line x1="20" y1="258" x2="110" y2="255" stroke="#FF9933" stroke-width="3" stroke-linecap="round" opacity="0.5"/>     <line x1="28" y1="270" x2="100" y2="268" stroke="#FF9933" stroke-width="2" stroke-linecap="round" opacity="0.3"/>     <line x1="15" y1="235" x2="90" y2="232" stroke="#FFD700" stroke-width="2" stroke-linecap="round" opacity="0.4"/>   </g>    <!-- ═══ GRADUATION CAP ═══ -->   <g transform="translate(256,128)" filter="url(#glow1)">     <!-- Cap board -->     <polygon points="0,-32 130,0 0,32 -130,0" fill="url(#saffron)"/>     <!-- Cap top darker overlay for depth -->     <polygon points="0,-32 130,0 0,10 -130,0" fill="#FF6B00" opacity="0.3"/>     <!-- Cap body -->     <path d="M-65,14 L-65,68 Q0,82 65,68 L65,14 Q0,28 -65,14 Z" fill="#FF9933"/>     <path d="M-65,14 L-65,68 Q0,82 65,68 L65,14 Q0,28 -65,14 Z" fill="#CC5500" opacity="0.25"/>     <!-- Tassel string -->     <line x1="130" y1="0" x2="148" y2="52" stroke="url(#gold)" stroke-width="4" stroke-linecap="round"/>     <!-- Tassel bob -->     <circle cx="148" cy="60" r="10" fill="url(#gold)" filter="url(#glow1)"/>     <!-- Shine on board -->     <polygon points="0,-32 50,-16 0,-2 -50,-16" fill="white" opacity="0.15"/>   </g>    <!-- ═══ TRICOLOR ACCENT BAR ═══ -->   <rect x="82" y="340" width="348" height="5" rx="2.5" fill="#FF9933"/>   <rect x="82" y="347" width="348" height="5" rx="2.5" fill="#ffffff" opacity="0.6"/>   <rect x="82" y="354" width="348" height="5" rx="2.5" fill="#138808"/>    <!-- ═══ APP NAME ═══ -->   <!-- Shadow layer -->   <text x="258" y="408" font-family="'Arial Black', 'Arial Bold', Arial, sans-serif"         font-size="52" font-weight="900" text-anchor="middle"         fill="#000000" opacity="0.4" letter-spacing="-1">ShikshaVega</text>   <!-- Main text: Shiksha white, Vega gold -->   <text x="256" y="405" font-family="'Arial Black', 'Arial Bold', Arial, sans-serif"         font-size="52" font-weight="900" text-anchor="middle" letter-spacing="-1">     <tspan fill="#ffffff">Shiksha</tspan><tspan fill="url(#gold)">Vega</tspan>   </text>    <!-- Tagline -->   <text x="256" y="438" font-family="Arial, sans-serif" font-size="18" font-weight="400"         text-anchor="middle" fill="#ffffff" opacity="0.5" letter-spacing="3">SCHOOL ERP</text>    <!-- Bottom tricolor strip -->   <clipPath id="bottomClip">     <rect width="512" height="512" rx="100"/>   </clipPath>   <g clip-path="url(#bottomClip)">     <rect x="0" y="488" width="170" height="24" fill="#FF9933"/>     <rect x="171" y="488" width="170" height="24" fill="#ffffff" opacity="0.85"/>     <rect x="342" y="488" width="170" height="24" fill="#138808"/>   </g> </svg>