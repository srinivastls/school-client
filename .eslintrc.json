{
  "env": {
    "es2021": true
  },
  "extends": [
    "plugin:react/recommended",
    "standard-with-typescript",
    "prettier",
    "prettier/react",
    "plugin:prettier/recommended"
  ],
  "overrides": [],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["react"],
  "rules": {
    "no-duplicate-imports": "warn",
    "comma-dangle": "off",
    "react/prop-types": ["off"],
    "react/jsx-filename-extension": [
      1,
      { "extensions": [".js", ".jsx", ".tsx"] }
    ],
    "import/no-cycle": "on",
    "camelcase": 1,
    "react/no-string-refs": "on",
    "react/destructuring-assignment": "on",
    "no-nested-ternary": "off",
    "radix": 1,
    "import/no-named-as-default-member": "off",
    "react/sort-comp": "off",
    "class-methods-use-this": "off",
    "global-require": "off",
    "react/default-props-match-prop-types": "off",
    "eqeqeq": "off",
    "no-underscore-dangle": "off",
    "no-return-assign": "off",
    "react-native/no-inline-styles": "error",
    "prettier/prettier": [
      "error",
      {
        "printWidth": 120
      }
    ],
    "curly": ["error", "all"],
    "sort-imports": ["warn", { "ignoreDeclarationSort": true }], // for sorting members inside an import
    "import/order": [
      "warn",
      {
        "groups": ["builtin", "external", "internal"],
        "pathGroups": [
          {
            "pattern": "@(react|react-native)",
            "group": "external",
            "position": "before"
          },
          {
            "pattern": "@school/**",
            "group": "external",
            "position": "after"
          }
        ],
        "pathGroupsExcludedImportTypes": [
          "@(react|react-native)",
          "@school/**"
        ],
        "newlines-between": "always",
        "alphabetize": {
          "order": "asc",
          "caseInsensitive": true
        }
      }
    ]
  },
  "settings": {
    "import/resolver": {
      "alias": {
        "map": [
          ["@school/assets", "./assets"],
          ["@school/components", "./components"],
          ["@school/store", "./store"],
          ["@school/services", "./services"],
          ["@school/theme", "./theme"],
          ["@school/types", "./types"],
          ["@school/navigation", "./navigation"]
        ]
      },
      "extensions": [".js", ".jsx", ".ts", ".tsx"]
    }
  }
}
